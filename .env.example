# --- Local development ---
# Get a key at https://console.cloud.google.com/google/maps-apis - enable
# "Places API (New)" and "Routes API", then restrict the key.
# Without this, the app runs on demo data.
VITE_GOOGLE_MAPS_API_KEY=

# Optional overrides - defaults point at the project's own Supabase instance.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=

# --- Vercel (production) ---
# Set GOOGLE_MAPS_API_KEY (no VITE_ prefix!) in the Vercel project's
# Environment Variables instead. It stays server-side; the browser calls
# the /api/google/* proxy functions.
